# =====================================================================
# Meseid - .env.example
# Salin menjadi .env lalu isi nilainya:   cp .env.example .env
#
# - JANGAN commit file .env (pastikan ada di .gitignore).
# - Jangan memakai komentar di baris yang sama dengan nilai.
# - Variabel bertanda [compose] sudah ditimpa otomatis oleh docker-compose.yml
#   saat berjalan di Docker; nilainya di sini hanya dipakai saat menjalankan
#   service langsung dari laptop (bun run dev:api, dst).
# =====================================================================

# ---------------------------------------------------------------------
# UMUM
# ---------------------------------------------------------------------
NODE_ENV=development

# ---------------------------------------------------------------------
# DATABASE (dibaca oleh service postgres dan untuk menyusun DATABASE_URL)
# Hindari karakter khusus (@ : / ?) pada password agar URL koneksi tidak rusak.
# ---------------------------------------------------------------------
POSTGRES_USER=meseid
POSTGRES_PASSWORD=ganti-dengan-password-kuat
POSTGRES_DB=meseid

# [compose] Di dalam Docker ditimpa ke host "postgres".
# Nilai ini dipakai saat db:migrate / db:seed / dev:api dijalankan dari laptop.
DATABASE_URL=postgresql://meseid:ganti-dengan-password-kuat@localhost:5432/meseid

# ---------------------------------------------------------------------
# API
# ---------------------------------------------------------------------
API_PORT=3000

# Alamat web yang dibuka di browser.
# Docker (service web): http://localhost:8080
# Dev SvelteKit (vite): http://localhost:5173
WEB_PORT=8080
APP_URL=http://localhost:8080

# Kunci sesi login dan enkripsi data sensitif (mis. kredensial sesi WhatsApp).
# Buat dengan:  openssl rand -hex 32
# ENCRYPTION_KEY harus 32 byte (64 karakter hex) jika memakai AES-256.
SESSION_SECRET=
ENCRYPTION_KEY=

# ---------------------------------------------------------------------
# GOOGLE (OAuth login + Drive + Calendar + Gmail, scope minimal)
# Buat OAuth client di Google Cloud Console (tipe Web application).
# Daftarkan GOOGLE_REDIRECT_URI persis sama di "Authorized redirect URIs".
# ---------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Lewat web/Nginx (Docker):  http://localhost:8080/api/auth/google/callback
# Dev vite:                  http://localhost:5173/api/auth/google/callback
# Langsung ke API:           http://localhost:3000/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# ---------------------------------------------------------------------
# AI PROVIDER (multi-model lewat adapter)
# Isi nama model sesuai penyedia yang dipakai saat implementasi.
# ---------------------------------------------------------------------
AI_PROVIDER_API_KEY=
AI_DEFAULT_MODEL_FREE=
AI_DEFAULT_MODEL_PRO=

# ---------------------------------------------------------------------
# MIDTRANS (pakai sandbox selama development)
# ---------------------------------------------------------------------
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# ---------------------------------------------------------------------
# KOMUNIKASI ANTAR-SERVICE (bot <-> api)
# Secret bersama; hanya dikirim lewat jaringan internal Docker.
# Buat dengan:  openssl rand -hex 32
# ---------------------------------------------------------------------
INTERNAL_API_SECRET=

# [compose] Alamat bot untuk API. Di Docker ditimpa ke http://bot:3001.
# Dipakai jika API dijalankan di laptop dan bot juga berjalan lokal.
BOT_INTERNAL_URL=http://localhost:3001

# [compose] Alamat API untuk bot. Di Docker ditimpa ke http://api:3000.
API_INTERNAL_URL=http://localhost:3000

# ---------------------------------------------------------------------
# BOT - TELEGRAM
# Token dari @BotFather. TELEGRAM_MODE: polling (mudah untuk dev) atau webhook.
# Jika webhook: butuh URL publik HTTPS dan TELEGRAM_WEBHOOK_SECRET.
# ---------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=

# ---------------------------------------------------------------------
# BOT - WHATSAPP (Baileys)
# [compose] Di Docker ditimpa ke /data/wa-session (volume meseid_wa_session).
# Saat dijalankan di laptop, pakai folder lokal yang masuk .gitignore.
# ---------------------------------------------------------------------
WA_SESSION_PATH=./data/wa-session
